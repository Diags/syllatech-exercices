// Valide partout. `versionne` n'est pas une option declaree par la Feature
// `java` — c'est `version`. Elle n'est donc pas exportee, la Feature prend
// sa valeur par defaut, et rien ne le signale.
{
  "name": "Option mal nommee",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "versionne": "21" }
  }
}
