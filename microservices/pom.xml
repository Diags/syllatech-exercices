<?xml version="1.0" encoding="UTF-8"?>
<!--
  Portail de l'emploi — projet du cours « Microservices avec Spring Cloud ».

  ⚠️ TOUT TOURNE DANS UNE SEULE JVM, et pourtant rien n'est simulé : un
  VRAI serveur Eureka, de VRAIS services qui s'y enregistrent, une VRAIE
  Spring Cloud Gateway avec son circuit breaker Resilience4j. Les
  chapitres demarrent ces applications sur des ports libres et les
  interrogent en HTTP.

  ⚠️ SPRING BOOT 4.0.8, ET NON 4.1. Le train Spring Cloud 2025.1.3 declare
  `spring-boot.version` 4.0.8 : il est compile et teste contre cette
  version. Le train a toujours un temps de retard sur Boot, et suivre
  cette matrice est la seule facon d'eviter des incompatibilites qui
  n'apparaissent qu'a l'execution.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>fr.portail</groupId>
  <artifactId>microservices-portail</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Portail de l'emploi — microservices</name>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-cloud.version>2025.1.3</spring-cloud.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
    </dependency>
    <!--
      ⚠️ `spring-cloud-starter-gateway-server-webmvc`, et NON
      `spring-cloud-starter-gateway`. La passerelle a ete scindee : le
      starter unique que l'on trouve dans tous les tutoriels est reste a la
      version 4.3.x, tandis que les nouveaux artefacts suivent le train.
      Le chapitre 3 explique ce que cela change, a commencer par le nom des
      proprietes de configuration.
    -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway-server-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
    </plugins>
  </build>
</project>
